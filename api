
export default {
    async fetch(request) {

        if (request.method !== "POST") {
            return new Response(
                JSON.stringify({
                    error: "POST requests only"
                }),
                {
                    status: 405,
                    headers: {
                        "Content-Type": "application/json"
                    }
                }
            );
        }

        try {

            const data = await request.json();

            const email = data.email;
            const items = data.items;

            if (!email || !items || items.length === 0) {

                return new Response(
                    JSON.stringify({
                        error: "Missing email or items"
                    }),
                    {
                        status: 400,
                        headers: {
                            "Content-Type": "application/json"
                        }
                    }
                );

            }

            const orderId =
                "BLX-" +
                Math.floor(
                    100000 + Math.random() * 900000
                );

            return new Response(
                JSON.stringify({
                    success: true,
                    orderId: orderId,
                    status: "pending"
                }),
                {
                    status: 200,
                    headers: {
                        "Content-Type": "application/json"
                    }
                }
            );

        } catch (error) {

            return new Response(
                JSON.stringify({
                    error: "Invalid request"
                }),
                {
                    status: 400,
                    headers: {
                        "Content-Type": "application/json"
                    }
                }
            );

        }

    }
};
